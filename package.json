{
  "name": "agents-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agents-memory": "dist/cli.js",
    "agents-memory-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "start:mcp": "node dist/mcp.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
